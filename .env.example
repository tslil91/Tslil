# Copy to .env.local and fill in. Without these, the app runs in demo mode (data stays on this device).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public VAPID key for reminders (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
